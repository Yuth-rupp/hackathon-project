        </div>

        {dischargeLoading && (
          <div className="rounded-lg border border-navy-800 bg-navy-950/50 p-8 text-center text-sm text-slate-400">
            Loading discharge forecast...
          </div>
        )}

        {!dischargeLoading && dischargeError && (
