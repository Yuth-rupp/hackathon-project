      </section>

      {/* ================================================== */}
      {/* SECTION 3: HYDROLOGICAL GAUGE STATIONS */}
      {/* ================================================== */}

      <section className="rounded-xl border border-navy-800 bg-navy-900/60 p-5">
        <div className="mb-4 flex items-center gap-2">
