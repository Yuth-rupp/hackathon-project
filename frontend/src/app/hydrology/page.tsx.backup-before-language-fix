          </div>
        ) : dischargeChartData.length > 0 ? (
          <TimeSeriesChart
            title={dischargeData?.location_name ?? "Discharge Forecast"}
            subtitle="Daily river discharge forecast"
            data={dischargeChartData}
            xKey="date"
            yKeys={[
              {
                key: "discharge_m3s",
                name: "Discharge",
                color: "#06b6d4",
                type: "area",
