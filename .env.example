# FloodPulse AI Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# General
# ======================
APP_NAME=FloodPulse AI
APP_ENV=development
DEBUG=true

# ======================
# Database
# ======================
DATABASE_URL=sqlite:///./floodpulse.db

# ======================
# API Keys (Optional)
# ======================
# MRC Data Services - requires PDIES credentials from mrcs@mrcmekong.org
MRC_API_TOKEN=
MRC_API_BASE_URL=https://data-services.mrcmekong.org/api/v1

# NASA FIRMS - free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# Copernicus Data Space - free account from https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ======================
# Telegram Bot
# ======================
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ======================
# Frontend
# ======================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ======================
# Scheduler
# ======================
WEATHER_REFRESH_MINUTES=60
DISCHARGE_REFRESH_HOURS=24
SATELLITE_REFRESH_HOURS=6
RISK_ASSESSMENT_HOURS=3
ALERT_CHECK_MINUTES=30
