# ==============================================================================
# FloodPulse AI - Environment Configuration
# Tonle Sap Lake Flood Monitoring Platform for Cambodia
# ==============================================================================

# Application Settings
APP_ENV=development
APP_NAME="FloodPulse AI"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=floodpulse_development_secret_key_change_in_production_2026

# Database Configuration (aiosqlite)
DATABASE_PATH=floodpulse.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,*"

# ------------------------------------------------------------------------------
# External API Endpoints (Real Public & Research Endpoints)
# ------------------------------------------------------------------------------

# Open-Meteo APIs (Free, No Auth Required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Copernicus STAC Catalog (Free, No Auth Required for Catalog Search)
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
COPERNICUS_COLLECTION=sentinel-1-grd

# JRC Global Surface Water (Google Cloud Storage Public Bucket)
JRC_TILE_URL_TEMPLATE=https://storage.googleapis.com/global-surface-water/tiles2021/{layer}/{z}/{x}/{y}.png
JRC_DOWNLOAD_URL_TEMPLATE=https://storage.googleapis.com/global-surface-water/downloads2021/{layer}/{layer}_100E_20N.tif

# Open Development Cambodia (ODC) CKAN API (Public Open Data)
ODC_CKAN_API_URL=https://data.opendevelopmentcambodia.net/api/3/action/package_search

# Mekong River Commission (MRC) Hydrological Services
# Official portal: https://data-services.mrcmekong.org/
# Requires approved institutional partner token; if empty, connector operates in graceful 'auth_required' mode
MRC_API_BASE_URL=https://data-services.mrcmekong.org/api/v1/hydromet
MRC_API_TOKEN=

# NASA FIRMS (Fire Information for Resource Management System)
# Register free MAP KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Used for thermal/dryness tracking across Tonle Sap floodplains
FIRMS_API_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv

# ------------------------------------------------------------------------------
# Telegram Emergency Alert Integration
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=9088888044:AAHtw5Zp7dlKFnOVumKJZSe1BX1I_0_itek
TELEGRAM_CHAT_ID=1247516194
TELEGRAM_ALERTS_ENABLED=True
TELEGRAM_BOT_ENABLED=True
# ------------------------------------------------------------------------------
# Background Ingestion / APScheduler Intervals
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
WEATHER_REFRESH_INTERVAL_MINUTES=60
DISCHARGE_REFRESH_INTERVAL_HOURS=6
SATELLITE_CATALOG_CHECK_HOURS=12
